/target
# claude code
.claude/settings.local.json
.claude/worktrees/

# standard defaults (mirrors ~/.config/git/ignore)
.DS_Store
._*
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
.idea/
.cursor/
*.swp
*~
node_modules/
__pycache__/
*.pyc
.venv/
venv/
*.log

# env files (mirrors ~/.config/git/ignore — defense in depth)
.env
.env.local
.env.dev
.env.development
.env.production
.env.staging
.env.test
.envrc.local
.vercel/

# Advent of Code puzzle inputs and examples: the puzzle author asks people
# not to publish them. Keep your own copies locally next to each solution.
/src/*/day_*/*.txt
